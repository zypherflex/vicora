# Test-only configuration for the isolated vicora_test database. These are local development
# credentials created by scripts/setup-db.sql, not secrets for any real environment.
NODE_ENV=test
APP_URL=http://localhost:3100
DATABASE_URL=postgres://vicora_app:vicora_app_dev_only@localhost:5432/vicora_test
DATABASE_SYSTEM_URL=postgres://vicora_owner:vicora_owner_dev_only@localhost:5432/vicora_test
DB_POOL_MAX=5
APP_SECRET=test-only-app-secret-not-used-anywhere-else-0123456789
PAYMENTS_WEBHOOK_SECRET=test-only-webhook-secret-0123456789
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-test
ANTHROPIC_API_KEY=
EMAIL_PROVIDER=outbox
JOBS_IN_PROCESS=false
DEMO_MODE=true
LOG_LEVEL=error
