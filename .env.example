# Copy to .env and adjust. Never commit real secrets.
APP_URL=http://localhost:3000

# Web requests use the RLS-constrained role; jobs/migrations use the owner role.
DATABASE_URL=postgres://vicora_app:vicora_app_dev_only@localhost:5432/vicora
DATABASE_SYSTEM_URL=postgres://vicora_owner:vicora_owner_dev_only@localhost:5432/vicora
DB_POOL_MAX=10

# 32+ random characters, e.g. `openssl rand -base64 48`
APP_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
SESSION_TTL_DAYS=14

# Private document storage. "local" writes outside the public web root.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
MAX_UPLOAD_BYTES=15728640

# Payments: "sandbox" is a clearly labeled demonstration provider. Stripe is not implemented yet.
PAYMENTS_PROVIDER=sandbox
PAYMENTS_WEBHOOK_SECRET=replace-me-sandbox-webhook-secret

# Optional. Without a key the AI copilot uses a deterministic, labeled demonstration engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Email goes to the in-app outbox (no external delivery) until a provider is connected.
EMAIL_PROVIDER=outbox

# Run the background job worker inside the web process (dev). In production run `npm run worker`.
JOBS_IN_PROCESS=true
DEMO_MODE=true
LOG_LEVEL=info
